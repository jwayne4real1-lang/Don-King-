# Environment Configuration for Don King Rap Battles

# LOCAL DEVELOPMENT (use localhost during testing)
# REACT_APP_API_URL=http://localhost:5000

# RENDER CLOUD SERVER (use this in production)
REACT_APP_API_URL=https://your-app.onrender.com

# Stripe Configuration (if using payment features)
REACT_APP_STRIPE_PUBLIC_KEY=pk_test_your_key_here

# Application Settings
REACT_APP_ENABLE_VOTING=true
REACT_APP_POLL_INTERVAL=2000
